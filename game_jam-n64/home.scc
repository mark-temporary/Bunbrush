#include <scummVars6.s>
#include "common.sch"
#include "home.sch"
#include "road.sch"
#include "inventoryitems.sch"
#include "verbs.sch"
#include "actors.sch"
#include "shop.sch"

room Home {
    image = "graphics/rooms/home.bmp";
    zplane = { "graphics/rooms/empty_room-z.bmp" };

    boxd = "graphics/rooms/home.box";
    trans = 0;

    sound dropkeySnd = "voices/dropkey.voc";
    sound puttySnd = "voices/putty.voc";

    object door {
        trans = 0;
        x =  190;
        y =   65;
        w =   60;
        h =   90;
        name = "Door";
        dir = NORTH;
        verb(int vrb,int objA,int objB) {
        case Interact:
            if (getObjectOwner(InventoryItems::screwdriver) == VAR_EGO & !uncloggedLock) {
                uncloggedLock = 1;
                animateActor(VAR_EGO, bunbrush_anim_raiseArm);
                delay(20);
                startSound(dropkeySnd);
                egoSay("Let's plop that keyhole");
                waitForMessage();
            } else if (getObjectOwner(InventoryItems::putty) == VAR_EGO & uncloggedLock) {
                setObjectOwner(InventoryItems::putty, 0);
                pickupObject(InventoryItems::puttyWithKeyPrint, InventoryItems);
                animateActor(VAR_EGO, bunbrush_anim_raiseArm);
                delay(20);
                startSound(puttySnd);
                egoSay("Let's get a print of the inside of that keyhole");
                waitForMessage();
            } else if (getObjectOwner(InventoryItems::puttyWithKeyPrint) == VAR_EGO) {
                animateActor(VAR_EGO, bunbrush_anim_raiseArm);
                delay(20);
                startSound(puttySnd);
                egoSay("That plopping sound is soooo satisfying");
                waitForMessage();
            } else if (uncloggedLock) {
                egoSay("I unclogged the keyhole!");
                waitForMessage();
            } else {
                checkedDoor = 1;
                egoSay("Somebody broke off a key. Did I do that?");
                waitForMessage();
            }
            return;
        }
    }

    object exit {
        trans = 0;
        x =  170;
        y =  185;
        w =   95;
        h =   15;
        name = "Head out";
        dir = SOUTH;
        verb(int vrb,int objA,int objB) {
        case Interact:
            setObjectState(ResRoom::inventoryPopup, 0);
            putActorAt(bunbrush, 100, 100, Road);
            startRoom(Road);
            return;
        }
    }

    object inventoryObj {
        name = "Inventory";
        verb(int vrb,int objA,int objB) {
        case Interact:
            if (getObjectState(ResRoom::inventoryPopup) == 0) {
                setObjectState(ResRoom::inventoryPopup, 1);
                // Small delay to fix the draw order
                delay(1);
                Verbs::showVerbs(1);
            } else {
                Verbs::showVerbs(0);
                setObjectState(ResRoom::inventoryPopup, 0);
            }
            return;
        }
    }

    local script entry() {
        Actors::setupActors();

        putActorAt(bunbrush,215,175,Home);

        putActorAt(inventory, 10, 190,Home);

        actorObject[inventory] = inventoryObj;

        if (Shop::turtleIsDone) {
            setRoomRGBIntensity( 143, 123, 80, 16, 223 );
        }

        createBoxMatrix();
        cameraFollowActor(VAR_EGO);
    }
}
