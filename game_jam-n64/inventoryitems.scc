#include <scummVars6.s>
#include "common.sch"
#include "inventoryitems.sch"

room InventoryItems {

    object screwdriver {
        w = 32;
        h = 32;
        x = 0;
        name = "Screwdriver";
        states = {
            { 0, 0, "graphics/inventory_items/screwdriver.bmp" }
        };
        state = 1;

        verb(int vrb,int objA,int objB) {
        case Interact:
            egoSay("A trusty screwdriver");
            waitForMessage();
            return;
        }
    }

    object putty {
        w = 32;
        h = 32;
        x = 0;
        name = "A ball of putty";
        states = {
            { 0, 0, "graphics/inventory_items/putty.bmp" }
        };
        state = 1;
    }

    object puttyWithKeyPrint {
        w = 32;
        h = 32;
        x = 0;
        name = "Putty with the shape of a skeleton key imprinted in it";
        states = {
            { 0, 0, "graphics/inventory_items/puttyWithKeyPrint.bmp" }
        };
        state = 1;
    }
}
