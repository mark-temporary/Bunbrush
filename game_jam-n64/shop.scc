#include <scummVars6.s>
#include "common.sch"
#include "road.sch"
#include "map.sch"
#include "inventoryitems.sch"
#include "verbs.sch"
#include "actors.sch"
#include "shop.sch"

room Shop {
    image = "graphics/rooms/shop.bmp";
    zplane = { "graphics/rooms/empty_room-z.bmp" };

    boxd = "graphics/rooms/shop.box";

    trans = 0;

    sound puttySnd = "voices/putty.voc";

    object turtleObj {
        name = "Mr. Turtle";
        verb(int vrb,int objA,int objB) {
        int rnd;
        case Interact:
            if (getObjectOwner(InventoryItems::puttyWithKeyPrint) == VAR_EGO & !turtleIsBusy) {
                setObjectOwner(InventoryItems::puttyWithKeyPrint, 0);
                animateActor(VAR_EGO, bunbrush_anim_raiseArm);
                turtleIsBusy = 1;
                delay(20);
                startSound(puttySnd);
                actorSay(turtle, "Thank you, Bunbrush! Now come back later.");
                waitForMessage();
            } else if (turtleIsBusy) {
                rnd = getRandomNumber(3);
                switch(rnd) {
                    case 1:
                        actorSay(turtle, "I'm not done yet. Come back in a moment!");
                        waitForMessage();
                        break;
                    case 2:
                        actorSay(turtle, "Come back later, Bunbrush...");
                        waitForMessage();
                        break;
                    case 3:
                        actorSay(turtle, "If you want me to work faster, you might have to turn the clock.");
                        waitForMessage();
                        break;
                }
            }
            return;
        }
    }

    object exit {
        trans = 0;
        x =   50;
        y =  180;
        w =  200;
        h =   20;
        name = "Leave shop";
        dir = SOUTH;
        verb(int vrb,int objA,int objB) {
        case Interact:
            setObjectState(ResRoom::inventoryPopup, 0);
            putActorAt(bunbrush, 100, 100, Map);
            playCDTrack(1,365,1,115067);
            delay(10);
            startRoom(Map);
            return;
        }
    }

    object inventoryObj {
        name = "Inventory";
        verb(int vrb,int objA,int objB) {
        case Interact:
            if (getObjectState(ResRoom::inventoryPopup) == 0) {
                setObjectState(ResRoom::inventoryPopup, 1);
            } else {
                setObjectState(ResRoom::inventoryPopup, 0);
            }
            return;
        }
    }

    local script entry() {
        Verbs::setupVerbs();
        Verbs::showVerbs(0);
        Actors::setupActors();

        putActorAt(bunbrush,100,100,Shop);
        putActorAt(inventory, 10, 190,Shop);

        actorObject[inventory] = inventoryObj;

        createBoxMatrix();
        cameraFollowActor(VAR_EGO);

        playCDTrack(4,1,1,72000);
    }
}
