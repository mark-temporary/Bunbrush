#include <scummVars6.s>
#include "common.sch"
#include "road.sch"
#include "map.sch"
#include "inventoryitems.sch"
#include "verbs.sch"
#include "actors.sch"
#include "shop.sch"
#include "dialog.sch"
#include "home.sch"
#include "outro.sch"

room Shop {
    image = "graphics/rooms/shop.bmp";
    zplane = { "graphics/rooms/empty_room-z.bmp" };

    boxd = "graphics/rooms/shop.box";

    trans = 0;

    sound puttySnd = "voices/putty.voc";

    object turtleObj {
        name = "Mr. Turtle";
        dir = EAST;
        verb(int vrb,int objA,int objB) {
        int rnd;
        case Interact:
            if (getObjectOwner(InventoryItems::puttyWithKeyPrint) == VAR_EGO & !turtleIsBusy) {
                setObjectOwner(InventoryItems::puttyWithKeyPrint, turtle);
                animateActor(VAR_EGO, bunbrush_anim_raiseArm);
                turtleIsBusy = 1;
                delay(20);
                startSound(puttySnd);
                actorSay(turtle, "Thank you, Bunbrush! Now come back later.");
                waitForMessage();
            } else if (turtleIsBusy & !turtleIsDone) {
                rnd = getRandomNumber(3);
                switch(rnd) {
                    case 1:
                        actorSay(turtle, "I'm not done yet. Come back in a moment!");
                        waitForMessage();
                        break;
                    case 2:
                        actorSay(turtle, "Come back later, Bunbrush...");
                        waitForMessage();
                        break;
                    case 3:
                        actorSay(turtle, "If you want me to work faster, you might have to turn the clock.");
                        waitForMessage();
                        break;
                }
            } else if (turtleIsDone) {
            cutscene(0) {
                actorSay(turtle, "There you go! Don't break it again and go home now. Buniver probably misses you, mate.");
                waitForMessage();
                }
                startRoom(Outro);
            } else {
                turtleConvo();
            }
            return;
        }
    }

    object exit {
        trans = 0;
        x =  160;
        y =  180;
        w =  200;
        h =   20;
        name = "Leave shop";
        dir = SOUTH;
        verb(int vrb,int objA,int objB) {
        case Interact:
            setObjectState(ResRoom::inventoryPopup, 0);
            putActorAt(bunbrush, 100, 100, Map);
            playCDTrack(1,365,1,115067);
            delay(10);
            startRoom(Map);
            return;
        }
    }

    object inventoryObj {
        name = "Inventory";
        verb(int vrb,int objA,int objB) {
        case Interact:
            if (getObjectState(ResRoom::inventoryPopup) == 0) {
                setObjectState(ResRoom::inventoryPopup, 1);
                // Small delay to fix the draw order
                delay(1);
                Verbs::showVerbs(1);
            } else {
                Verbs::showVerbs(0);
                setObjectState(ResRoom::inventoryPopup, 0);
                setCursorImage(ResRoom::DefaultCursor, ResRoom);
                setCursorTransparency(0);
            }
            return;
        }
    }

    local script entry() {
        Verbs::showVerbs(0);
        Actors::setupActors();

        putActorAt(bunbrush,100,100,Shop);
        putActorAt(inventory, 10, 190,Shop);

        actorObject[inventory] = inventoryObj;

        if (turtleIsDone) {
            setRoomRGBIntensity( 143, 123, 80, 16, 159 );
            setRoomRGBIntensity( 143, 123, 80, 192, 223 );
        }

        createBoxMatrix();
        cameraFollowActor(VAR_EGO);

        playCDTrack(4,1,1,72000);
    }

    local script turtleConvo() {
            char* sentence;
            int event;
            cutscene(0) {
                if (talkedBefore) {
                    actorSay(turtle, "Hey, Bunbrush! Back so soon?");
                    waitForMessage();
                } else {
                    actorSay(turtle, "Hello, Bunbrush! Long time no see! How are you?");
                    waitForMessage();
                }
            }
            dialogLoop: while(1) {
                if (Home::checkedDoor) {
                    sentence = 0;
                    sentence[0] = "I can't get into my home. The key broke off";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else if (!convoTopicBuniver) {
                    sentence = 0;
                    sentence[0] = "I'm fine. You yourself?";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else {
                    sentence = 0;
                    sentence[0] = "We don't talk anymore. Ever since ... the incident";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                }

                if (!convoTopicFullgame) {
                    sentence[0] = "How's business?";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else if (convoTopicFullgame & !convoTopicDreamdisc) {
                    sentence[0] = "The what??";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else if (convoTopicDreamdisc & !convoTopicSCUNK) {
                    sentence[0] = "Dreamdisc?";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else if (convoTopicFullgame & convoTopicDreamdisc & convoTopicSCUNK & !convoTopicAll){
                    sentence[0] = "What's SCUNK?";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                } else if (convoTopicAll) {
                    sentence[0] = "That's all just nuts!";
                    Dialog::dialogAdd(sentence);
                    sentence = 0;
                }

                sentence[0] = "See ya!";
                Dialog::dialogAdd(sentence);
                sentence = 0;

                Dialog::dialogStart(BUNBRUSH_DIM_COLOR,BUNBRUSH_COLOR);
                do breakScript() while(selectedSentence < 0);
                Dialog::dialogHide();
                cutscene() {
                    switch(selectedSentence) {
                    case 0: 
                        if (Home::checkedDoor) {
                            egoSay("I can't get into my home. The key broke off");
                            waitForMessage();
                            actorSay(turtle, "Oh no! Well... Don't fret! Bring me a print of your key and we'll fix this");
                            waitForMessage();
                            break;
                        } else if (!convoTopicBuniver) {
                            convoTopicBuniver = 1;
                            egoSay("I'm fine. You yourself?");
                            waitForMessage();
                            actorSay(turtle, "Having a bit of a supply crisis if you can't tell. Nothing is in stock. How's your mate Buniver?");
                            waitForMessage();
                            break;
                        } else {
                            egoSay("We don't talk anymore. Ever since ... the incident");
                            waitForMessage();
                            actorSay(turtle, "Oh come now, mate! It was just a silly trading card! Give it a rest, go home now and call him!");
                            waitForMessage();
                            break;
                        }
                    case 1:
                        if (!convoTopicFullgame) {
                            convoTopicFullgame = 1;
                            egoSay("How's business?");
                            waitForMessage();
                            actorSay(turtle, "Totally sold out of everything. Can't wait for the full version.");
                            waitForMessage();
                            break;
                        } else if (convoTopicFullgame & !convoTopicDreamdisc) {
                            convoTopicDreamdisc = 1;
                            egoSay("The what??");
                            waitForMessage();
                            actorSay(turtle, "You know. The full version of this game. When that fella is finally releasing his SCUNK engine to the public. Can't wait for the Dreamdisc release either");
                            waitForMessage();
                            break;
                        } else if (convoTopicDreamdisc & !convoTopicSCUNK) {
                            convoTopicSCUNK = 1;
                            egoSay("Dreamdisc?");
                            waitForMessage();
                            actorSay(turtle, "Another one of these fancy retro consoles you hip kids are all using. They say it has 128 bits. Whatever that means");
                            waitForMessage();
                            break;
                        } else if (convoTopicFullgame & convoTopicDreamdisc & convoTopicSCUNK & !convoTopicAll) {
                            convoTopicAll = 1;
                            egoSay("What's SCUNK?");
                            waitForMessage();
                            actorSay(turtle, "It's inspired by those fine gentleman at some ancient film company. A game engine for those who can't let go of the past. Hehe");
                            waitForMessage();
                            break;
                        } else if (convoTopicAll) {
                            actorFace(bunbrush, turtle);
                            egoSay("That's all just nuts!");
                            waitForMessage();
                            actorSay(turtle, "I know. Nerds, right?...");
                            waitForMessage();
                            actorTurnToDirection(SOUTH);
                            egoSay("Yea... Nerds. Always behind their screens...");
                            waitForMessage();
                            break;
                        }
                    case 2:
                        talkedBefore = 1;
                        actorSay(turtle, "See ya around");
                        waitForMessage();
                        break;
                    }
                    waitForMessage();
                }
                Dialog::dialogClear(1);
                if(selectedSentence == 2) break dialogLoop;
            }
            Dialog::dialogEnd();
    }
}
